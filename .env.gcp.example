# Copy values from Firebase/GCP settings. Never commit real secret values.
GCP_PROJECT_ID=<PROJECT_ID>
GCP_REGION=us-<REGION>
CLOUD_RUN_SERVICE=pearlhub-backend
CLOUD_RUN_RUNTIME_SERVICE_ACCOUNT=<RUNTIME_SERVICE_ACCOUNT_EMAIL>
CLOUD_SQL_INSTANCE=<PROJECT_ID>:<REGION>:<INSTANCE_NAME>
CLOUD_SQL_DATABASE=<DATABASE_NAME>
CLOUD_SQL_USER=<APP_DATABASE_USER>
CLOUD_SQL_DATABASE_URL_SECRET=<SECRET_MANAGER_SECRET_NAME_CONTAINING_DATABASE_URL>
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
ARTIFACT_REGISTRY_REPOSITORY=<REPOSITORY_NAME>
ARTIFACT_REGISTRY_IMAGE=pearlhub-backend
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
