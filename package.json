{
  "name": "pearlhub-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "db:migrate": "npm run build && node dist/src/migrate.js",
    "db:migrate:baseline": "npm run build && node dist/src/migrate.js --baseline",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/application tests/contracts",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.10.0",
    "pg": "^8.16.3",
    "semver": "^7.7.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}